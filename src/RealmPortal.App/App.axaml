<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RealmPortal.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://RealmPortal.App/Theme/Tokens.axaml"/>
        <ResourceInclude Source="avares://RealmPortal.App/Theme/Fonts.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://RealmPortal.App/Theme/Typography.axaml"/>
  </Application.Styles>
</Application>

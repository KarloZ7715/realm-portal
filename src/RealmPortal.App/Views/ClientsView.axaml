<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:RealmPortal.App.Controls"
             xmlns:vm="using:RealmPortal.App.ViewModels"
             xmlns:loc="using:RealmPortal.App.Localization"
             x:Class="RealmPortal.App.Views.ClientsView"
             x:DataType="vm:ClientsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,0,12">
    <StackPanel Margin="20,10,20,0">
      <Grid ColumnDefinitions="*,Auto" Height="44">
        <TextBlock Classes="h1" Foreground="{DynamicResource IvoryBrush}" VerticalAlignment="Center" Text="{loc:T clients.title}"/>
        <Button Grid.Column="1" Name="PickButton" Classes="secondary compact" c:ButtonSurface.Surface="Parchment" VerticalAlignment="Center" Command="{Binding PickFolderCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:Icon Data="{DynamicResource IconFolder}" Width="16" Height="16" StrokeThickness="2"/>
            <TextBlock Text="{loc:T clients.pick}"/>
          </StackPanel>
        </Button>
      </Grid>
      <TextBlock Name="Subtitle" Classes="sheet-subtitle" Text="{Binding Summary}"/>
      <TextBlock Name="ScanNotice" Classes="body-sm" Foreground="{DynamicResource BoneSoftBrush}" Margin="0,0,0,12"
                 Text="{Binding Notice}" IsVisible="{Binding HasNotice}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>

      <!-- The sheet is drawn with the parchment tile art, so it grows with the list. -->
      <ContentControl Name="ClientsSheet" Classes="card" Padding="22,14,22,6" Margin="0,0,0,0">
        <StackPanel>
          <TextBlock Classes="sheet-title" Text="{loc:T clients.sheet}" Margin="0,2,0,8"/>
          <Line Classes="stitch parchment" StartPoint="0,0" EndPoint="1,0" Stretch="Fill" Margin="0,0,0,2"/>
          <ItemsControl Name="ClientList" ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ClientItemViewModel">
                <Border BorderBrush="{DynamicResource ParchmentShadowBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                    <CheckBox Classes="parchment" IsChecked="{Binding IsInUse, Mode=TwoWay}" VerticalAlignment="Center"
                              AutomationProperties.Name="{loc:T clients.inuse}" ToolTip.Tip="{loc:T clients.inuse}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="body-bold" FontSize="16" Foreground="{DynamicResource InkBrush}" Text="{Binding Title}"/>
                        <TextBlock Classes="body-sm" FontSize="12" Foreground="{DynamicResource InkSoftBrush}" Text="{Binding Version}"
                                   IsVisible="{Binding ShowNamedVersion}" VerticalAlignment="Center"/>
                      </StackPanel>
                      <TextBlock Classes="path" FontSize="13" Foreground="{DynamicResource InkSoftBrush}" Text="{Binding Path}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                      <c:Badge Status="Active" Text="{loc:T clients.state.running}" IsVisible="{Binding IsRunning}"/>
                      <c:Badge Status="Inactive" Text="{Binding OriginText}" IsVisible="{Binding ShowOriginBadge}"/>
                      <TextBlock Classes="footnote" Foreground="{DynamicResource InkSoftBrush}" Text="{loc:T clients.state.unknown}"
                                 IsVisible="{Binding IsStateUnknown}" ToolTip.Tip="{loc:T clients.state.unknown}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4" IsVisible="{Binding CanManage}">
                      <Button Classes="ghost surface-parchment" Width="28" Height="28" Padding="6" Command="{Binding EditCommand}"
                              ToolTip.Tip="{loc:T clients.action.edit}" AutomationProperties.Name="{loc:T clients.action.edit}">
                        <c:Icon Data="{DynamicResource IconPencil}" Width="14" Height="14" StrokeThickness="1.8"/>
                      </Button>
                      <Button Classes="ghost surface-parchment" Width="28" Height="28" Padding="6" Command="{Binding RemoveCommand}"
                              ToolTip.Tip="{loc:T clients.action.remove}" AutomationProperties.Name="{loc:T clients.action.remove}">
                        <c:Icon Data="{DynamicResource IconClose}" Width="14" Height="14" StrokeThickness="2" Foreground="{DynamicResource WaxTextBrush}"/>
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ContentControl>

      <StackPanel Orientation="Horizontal" Spacing="28" Margin="14,14,0,0">
        <Button Name="RescanButton" Classes="link caps" Command="{Binding RescanCommand}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:Icon Data="{DynamicResource IconRefresh}" Width="14" Height="14" StrokeThickness="2.2"/>
            <TextBlock Text="{loc:T clients.rescan}"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>

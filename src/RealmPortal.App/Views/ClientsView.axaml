<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:RealmPortal.App.Controls"
             xmlns:vm="using:RealmPortal.App.ViewModels"
             xmlns:loc="using:RealmPortal.App.Localization"
             x:Class="RealmPortal.App.Views.ClientsView"
             x:DataType="vm:ClientsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,0,12">
    <StackPanel Margin="20,10,20,0">
      <Grid ColumnDefinitions="*,Auto" Height="44">
        <TextBlock Classes="h1" Foreground="{DynamicResource IvoryBrush}" VerticalAlignment="Center" Text="{loc:T clients.title}"/>
        <Button Grid.Column="1" Name="PickButton" Classes="secondary compact" VerticalAlignment="Center" Command="{Binding PickFolderCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:Icon Data="{DynamicResource IconFolder}" Width="16" Height="16" StrokeThickness="2"/>
            <TextBlock Text="{loc:T clients.pick}"/>
          </StackPanel>
        </Button>
      </Grid>
      <TextBlock Classes="body-sm" FontSize="14" Foreground="{DynamicResource BoneSoftBrush}" Margin="0,2,0,14" Text="{Binding Summary}"/>

      <!-- The sheet is drawn with the parchment tile art, so it grows with the list. -->
      <ContentControl Classes="card" Padding="22,14,22,6" Margin="0,0,0,0">
        <StackPanel>
          <TextBlock Classes="sheet-title" Text="{loc:T clients.sheet}" Margin="0,2,0,8"/>
          <Line Classes="stitch parchment" StartPoint="0,0" EndPoint="1,0" Stretch="Fill" Margin="0,0,0,2"/>
          <ItemsControl Name="ClientList" ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ClientItemViewModel">
                <Border BorderBrush="{DynamicResource ParchmentShadowBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <CheckBox Classes="parchment" IsChecked="{Binding IsInUse, Mode=TwoWay}" VerticalAlignment="Center"
                              AutomationProperties.Name="{loc:T clients.inuse}" ToolTip.Tip="{loc:T clients.inuse}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Classes="body-bold" FontSize="16" Foreground="{DynamicResource InkBrush}" Text="{Binding Title}"/>
                      <TextBlock Classes="path" FontSize="13" Foreground="{DynamicResource InkSoftBrush}" Text="{Binding Path}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <c:Badge Grid.Column="2" Status="Inactive" Text="{Binding OriginText}" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ContentControl>

      <StackPanel Orientation="Horizontal" Spacing="28" Margin="14,14,0,0">
        <Button Name="RescanButton" Classes="link caps" Command="{Binding RescanCommand}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:Icon Data="{DynamicResource IconRefresh}" Width="14" Height="14" StrokeThickness="2.2"/>
            <TextBlock Text="{loc:T clients.rescan}"/>
          </StackPanel>
        </Button>
        <TextBlock Classes="footnote" VerticalAlignment="Center" Foreground="{DynamicResource BoneSoftBrush}" Text="{loc:T clients.later}"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>

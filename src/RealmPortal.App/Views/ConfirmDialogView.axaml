<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RealmPortal.App.ViewModels"
             x:Class="RealmPortal.App.Views.ConfirmDialogView"
             x:DataType="vm:ConfirmDialogViewModel">
  <!-- Scrim + a parchment sheet. Cancel is the escape button and takes the first focus; the confirm button is the red wax one. -->
  <Panel Focusable="True" KeyboardNavigation.TabNavigation="Cycle">
    <Border Name="Scrim" Background="#99000000"/>
    <ContentControl Classes="card" Name="Sheet" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,22">
      <StackPanel Spacing="10">
        <TextBlock Classes="sheet-title" Name="DialogTitle" TextWrapping="Wrap" Text="{Binding Title}"/>
        <TextBlock Classes="body" Name="DialogBody" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}" Text="{Binding Body}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,10,0,0">
          <Button Name="CancelButton" Classes="secondary" MinWidth="130" IsCancel="True" Command="{Binding CancelCommand}">
            <TextBlock Text="{Binding CancelText}"/>
          </Button>
          <Button Name="ConfirmButton" MinWidth="130" Command="{Binding ConfirmCommand}">
            <TextBlock Text="{Binding ConfirmText}"/>
          </Button>
        </StackPanel>
      </StackPanel>
    </ContentControl>
  </Panel>
</UserControl>

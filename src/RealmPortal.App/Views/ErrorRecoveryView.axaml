<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:RealmPortal.App.ViewModels"
 x:Class="RealmPortal.App.Views.ErrorRecoveryView" x:DataType="vm:ErrorRecoveryViewModel" IsVisible="{Binding IsVisible}">
 <StackPanel Spacing="8" Margin="0,4,0,12">
  <TextBlock Name="RecoveryHint" Text="{Binding Hint}" TextWrapping="Wrap" Classes="body-sm" Foreground="{DynamicResource BoneSoftBrush}"/>
  <WrapPanel>
   <Button Name="RecoveryPrimary" Classes="secondary compact" Margin="0,0,8,8" IsVisible="{Binding HasPrimary}" Command="{Binding PrimaryCommand}" AutomationProperties.Name="{Binding PrimaryText}" AutomationProperties.HelpText="{Binding Hint}"><TextBlock Text="{Binding PrimaryText}" TextWrapping="Wrap"/></Button>
   <Button Name="RecoverySecondary" Classes="secondary compact" Margin="0,0,8,8" IsVisible="{Binding HasSecondary}" Command="{Binding SecondaryCommand}" AutomationProperties.Name="{Binding SecondaryText}" AutomationProperties.HelpText="{Binding Hint}"><TextBlock Text="{Binding SecondaryText}" TextWrapping="Wrap"/></Button>
  </WrapPanel>
 </StackPanel>
</UserControl>

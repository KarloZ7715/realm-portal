<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:RealmPortal.App.Controls"
             xmlns:vm="using:RealmPortal.App.ViewModels"
             xmlns:loc="using:RealmPortal.App.Localization"
             x:Class="RealmPortal.App.Views.AboutView"
             x:DataType="vm:AboutViewModel">
  <Grid RowDefinitions="Auto,*" Margin="20,10,20,0">
    <Grid ColumnDefinitions="Auto,*" Height="44">
      <Button Name="BackButton" Classes="link caps" AutomationProperties.Name="{loc:T about.back}" Command="{Binding BackCommand}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <c:Icon Data="{DynamicResource IconChevronLeft}" Width="12" Height="12" StrokeThickness="2.6"/>
          <TextBlock Text="{loc:T about.back}"/>
        </StackPanel>
      </Button>
      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="16,0,0,0">
        <TextBlock Classes="h1" Foreground="{DynamicResource IvoryBrush}" Text="{loc:T about.title}"/>
        <TextBlock Classes="footnote" Foreground="{DynamicResource BoneSoftBrush}" Text="{loc:T about.subtitle}"/>
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" Name="Scroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,6,14,12">
      <StackPanel Spacing="18">
        <ContentControl Classes="card" Padding="26,16,26,18">
          <StackPanel Spacing="10">
            <TextBlock Classes="sheet-title" Text="{loc:T about.identity}"/>
            <Line Classes="stitch parchment" StartPoint="0,0" EndPoint="1,0" Stretch="Fill"/>
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
              <Image Width="56" Height="56" Source="avares://RealmPortal.App/Assets/app-icon.png"
                     Stretch="Uniform" VerticalAlignment="Top"/>
              <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Name="AppName" Classes="body-bold" FontSize="18" Foreground="{DynamicResource InkBrush}" Text="{Binding AppName}"/>
                <TextBlock Name="VersionLabel" Classes="footnote" Foreground="{DynamicResource InkSoftBrush}" Text="{Binding VersionLabel}"/>
                <TextBlock Classes="footnote" Foreground="{DynamicResource InkSoftBrush}" Text="{Binding Copyright}"/>
              </StackPanel>
            </StackPanel>
            <TextBlock Classes="footnote" TextWrapping="Wrap" Foreground="{DynamicResource InkSoftBrush}" Text="{Binding Disclaimer}" Margin="0,4,0,0"/>
            <TextBlock Classes="body" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}" Text="{Binding CreditsText}"/>
            <TextBlock Classes="body" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}" Text="{Binding MitNote}"/>
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
              <Button Name="GitHubButton" Classes="secondary compact" MinWidth="200"
                      c:ButtonSurface.Surface="Parchment"
                      AutomationProperties.Name="{loc:T about.github}"
                      Command="{Binding OpenRepositoryCommand}">
                <TextBlock Text="{loc:T about.github}"/>
              </Button>
            </StackPanel>
            <TextBlock Name="OpenError" Classes="footnote" TextWrapping="Wrap" Foreground="{DynamicResource WaxTextBrush}"
                       IsVisible="{Binding OpenError, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Text="{Binding OpenError}"/>
            <TextBlock Classes="footnote" TextWrapping="Wrap" Foreground="{DynamicResource InkSoftBrush}" Text="{Binding RepositoryUrl}"/>
          </StackPanel>
        </ContentControl>

        <ContentControl Classes="card" Padding="26,16,26,18" IsVisible="{Binding HasThirdPartyLicenses}">
          <StackPanel Spacing="10">
            <TextBlock Classes="sheet-title" Text="{loc:T about.thirdparty}"/>
            <Line Classes="stitch parchment" StartPoint="0,0" EndPoint="1,0" Stretch="Fill"/>
            <TextBlock Classes="footnote" TextWrapping="Wrap" Foreground="{DynamicResource InkSoftBrush}" Text="{loc:T about.thirdparty.hint}"/>
            <Border Background="#14000000" CornerRadius="6" Padding="12" MaxHeight="220">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <TextBlock Name="ThirdPartyText" Classes="footnote mono" TextWrapping="Wrap"
                           Foreground="{DynamicResource InkBrush}" Text="{Binding ThirdPartyLicenses}"/>
              </ScrollViewer>
            </Border>
          </StackPanel>
        </ContentControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:RealmPortal.App.Controls"
             xmlns:vm="using:RealmPortal.App.ViewModels"
             xmlns:loc="using:RealmPortal.App.Localization"
             x:Class="RealmPortal.App.Views.AddServerView"
             x:DataType="vm:AddServerViewModel">
  <ScrollViewer Name="Scroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <!-- Bottom space is a margin on the content: ScrollViewer.Padding is not counted in the scroll extent (#210 follow-up). -->
    <StackPanel Name="ScrollContent" Margin="20,10,20,12">
      <TextBlock Classes="h1" Foreground="{DynamicResource IvoryBrush}" Height="44" VerticalAlignment="Center" Text="{Binding FormTitle}"/>
      <TextBlock Classes="footnote" Margin="0,-6,0,6" Foreground="{DynamicResource IvoryBrush}" TextWrapping="Wrap" IsVisible="{Binding IsEditing}" Text="{Binding FormSubtitle}"/>
      <ContentControl Classes="card" Padding="22,12,22,16" Margin="0,2,0,0">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,8">
            <TextBlock Classes="sheet-title" VerticalAlignment="Center" Text="{loc:T add.sheet}"/>
            <c:Badge Grid.Column="1" Name="ResultBadge" IsVisible="{Binding HasResult}" Status="{Binding ResultStatus}" Text="{Binding ResultText}"/>
          </Grid>
          <Line Classes="stitch parchment" StartPoint="0,0" EndPoint="1,0" Stretch="Fill" Margin="0,0,0,14"/>
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="20" RowSpacing="12">
          <StackPanel Spacing="6" Grid.Column="0" Grid.Row="0">
            <TextBlock Classes="body-bold" FontSize="16" Foreground="{DynamicResource InkBrush}" Text="{loc:T add.name}"/>
            <TextBox Name="NameBox" Classes="parchment" Classes.error="{Binding HasNameError}" Text="{Binding Name, Mode=TwoWay}" MaxLength="64"/>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding !HasNameError}">
              <c:Icon Data="{DynamicResource IconInfo}" Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{DynamicResource InkSoftBrush}" StrokeThickness="2"/>
              <TextBlock Grid.Column="1" Classes="footnote" TextWrapping="Wrap" Foreground="{DynamicResource InkSoftBrush}" Text="{loc:T add.name.help}"/>
            </Grid>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding HasNameError}">
              <c:Icon Data="{DynamicResource IconError}" Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{DynamicResource WaxTextBrush}" StrokeThickness="2"/>
              <TextBlock Grid.Column="1" Classes="footnote" TextWrapping="Wrap" Foreground="{DynamicResource WaxTextBrush}" Text="{Binding NameError}"/>
            </Grid>
          </StackPanel>
          <StackPanel Spacing="6" Grid.Column="1" Grid.Row="0">
            <TextBlock Classes="body-bold" FontSize="16" Foreground="{DynamicResource InkBrush}" Text="{loc:T add.address}"/>
            <TextBox Name="AddressBox" Classes="parchment" Classes.error="{Binding HasAddressError}" Text="{Binding Address, Mode=TwoWay}" AcceptsReturn="True" Watermark="logon.ejemplo.com:3724"/>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding !HasAddressError}">
              <c:Icon Data="{DynamicResource IconInfo}" Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{DynamicResource InkSoftBrush}" StrokeThickness="2"/>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Classes="footnote" TextWrapping="Wrap" Foreground="{DynamicResource InkSoftBrush}"
                           Text="{Binding AddressInterpretation}" IsVisible="{Binding HasAddressInterpretation}"/>
                <TextBlock Classes="footnote" TextWrapping="Wrap" Foreground="{DynamicResource InkSoftBrush}"
                           Text="{loc:T add.address.help}" IsVisible="{Binding !HasAddressInterpretation}"/>
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding HasAddressError}">
              <c:Icon Data="{DynamicResource IconError}" Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{DynamicResource WaxTextBrush}" StrokeThickness="2"/>
              <TextBlock Grid.Column="1" Classes="footnote" TextWrapping="Wrap" Foreground="{DynamicResource WaxTextBrush}" Text="{Binding AddressError}"/>
            </Grid>
          </StackPanel>
          <StackPanel Spacing="6" Grid.Column="0" Grid.Row="1">
            <TextBlock Classes="body-bold" FontSize="16" Foreground="{DynamicResource InkBrush}" Text="{loc:T add.client}"/>
            <ComboBox Name="ClientBox" Classes="parchment" Classes.error="{Binding HasClientError}" HorizontalAlignment="Stretch" ItemsSource="{Binding Clients.Items}" SelectedItem="{Binding SelectedClient, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ClientItemViewModel"><TextBlock Text="{Binding Label}"/></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding !HasClientError}">
              <c:Icon Data="{DynamicResource IconInfo}" Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{DynamicResource InkSoftBrush}" StrokeThickness="2"/>
              <TextBlock Grid.Column="1" Classes="footnote" TextWrapping="Wrap" Foreground="{DynamicResource InkSoftBrush}" Text="{loc:T add.client.help}"/>
            </Grid>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding HasClientError}">
              <c:Icon Data="{DynamicResource IconError}" Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{DynamicResource WaxTextBrush}" StrokeThickness="2"/>
              <TextBlock Grid.Column="1" Classes="footnote" TextWrapping="Wrap" Foreground="{DynamicResource WaxTextBrush}" Text="{Binding ClientError}"/>
            </Grid>
          </StackPanel>
          <StackPanel Spacing="6" Grid.Column="1" Grid.Row="1">
            <TextBlock Classes="body-bold" FontSize="16" Foreground="{DynamicResource InkBrush}" Text="{loc:T add.realm}"/>
            <TextBox Name="RealmBox" Classes="parchment" Text="{Binding Realm, Mode=TwoWay}" MaxLength="64" Watermark="{loc:T add.realm.watermark}"/>
          </StackPanel>
          <StackPanel Spacing="6" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2">
            <TextBlock Classes="body-bold" FontSize="16" Foreground="{DynamicResource InkBrush}" Text="{loc:T add.account}"/>
            <TextBox Name="AccountBox" Classes="parchment" Text="{Binding Account, Mode=TwoWay}" MaxLength="32"/>
            <StackPanel Orientation="Horizontal" Spacing="6" >
              <c:Icon Data="{DynamicResource IconInfo}" Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{DynamicResource InkSoftBrush}" StrokeThickness="2"/>
              <TextBlock Classes="footnote" Foreground="{DynamicResource InkSoftBrush}" Text="{loc:T add.account.help}"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Spacing="6" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3" IsVisible="{Binding IsEditing}">
            <TextBlock Classes="body-bold" FontSize="16" Foreground="{DynamicResource InkBrush}" Text="{loc:T edit.build}"/>
            <ComboBox Name="BuildBox" Classes="parchment" HorizontalAlignment="Stretch" ItemsSource="{Binding BuildOptions}" SelectedItem="{Binding SelectedBuild, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ServerBuildOption"><TextBlock Text="{Binding Label}"/></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Data="{DynamicResource IconInfo}" Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{DynamicResource InkSoftBrush}" StrokeThickness="2"/>
              <TextBlock Classes="footnote" TextWrapping="Wrap" Foreground="{DynamicResource InkSoftBrush}" Text="{loc:T edit.build.help}"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Spacing="6" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="4" IsVisible="{Binding IsEditing}">
            <CheckBox Name="ClearCacheBox" Classes="parchment" IsThreeState="True"
                      IsChecked="{Binding ClearCacheOnSwitch, Mode=TwoWay}"
                      Content="{loc:T edit.cache.clear}"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Data="{DynamicResource IconInfo}" Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{DynamicResource InkSoftBrush}" StrokeThickness="2"/>
              <TextBlock Classes="footnote" TextWrapping="Wrap" Foreground="{DynamicResource InkSoftBrush}" Text="{loc:T edit.cache.hint}"/>
            </StackPanel>
          </StackPanel>
          </Grid>
          <!-- Advanced: extra realmlist lines (#192). Collapsed by default; opens when the server already has lines. -->
          <Expander Name="AdvancedExpander"
                    Classes="parchment"
                    Margin="0,14,0,0"
                    Focusable="True"
                    IsExpanded="{Binding IsAdvancedExpanded, Mode=TwoWay}"
                    AutomationProperties.Name="{Binding AdvancedHeaderAccessibleName}">
            <Expander.Header>
              <TextBlock Classes="sheet-title" VerticalAlignment="Center" Text="{Binding AdvancedHeaderText}"/>
            </Expander.Header>
            <StackPanel Spacing="6" Margin="0,10,0,0" Opacity="1">
              <Line Classes="stitch parchment" StartPoint="0,0" EndPoint="1,0" Stretch="Fill" Margin="0,0,0,2"/>
              <TextBlock Classes="body-bold" FontSize="16" Foreground="{DynamicResource InkBrush}" Text="{loc:T add.advanced.lines}"/>
              <TextBox Name="ExtraLinesBox"
                       Classes="parchment mono"
                       Classes.error="{Binding HasExtraLinesError}"
                       AcceptsReturn="True"
                       TextWrapping="NoWrap"
                       MinHeight="76"
                       Height="76"
                       Padding="12,8"
                       VerticalContentAlignment="Top"
                       Foreground="{DynamicResource InkBrush}"
                       Watermark="{loc:T add.advanced.placeholder}"
                       Text="{Binding ExtraRealmlistLinesText, Mode=TwoWay}"
                       AutomationProperties.Name="{loc:T add.advanced.lines}"
                       AutomationProperties.HelpText="{loc:T add.advanced.help}"/>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding !HasExtraLinesError}">
                <c:Icon Data="{DynamicResource IconInfo}" Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{DynamicResource InkSoftBrush}" StrokeThickness="2"/>
                <TextBlock Grid.Column="1" Classes="footnote" TextWrapping="Wrap" Foreground="{DynamicResource InkSoftBrush}" Text="{loc:T add.advanced.help}"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding HasExtraLinesError}">
                <c:Icon Data="{DynamicResource IconError}" Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{DynamicResource WaxTextBrush}" StrokeThickness="2"/>
                <TextBlock Name="ExtraLinesError" Grid.Column="1" Classes="footnote" TextWrapping="Wrap" Foreground="{DynamicResource WaxTextBrush}" Text="{Binding ExtraLinesError}"/>
              </Grid>
            </StackPanel>
          </Expander>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,12,0,0" IsVisible="{Binding HasSaveError}">
            <c:Icon Data="{DynamicResource IconError}" Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{DynamicResource WaxTextBrush}" StrokeThickness="2"/>
            <TextBlock Name="SaveError" Grid.Column="1" Classes="footnote" TextWrapping="Wrap" Foreground="{DynamicResource WaxTextBrush}" Text="{Binding SaveError}"/>
          </Grid>
        </StackPanel>
      </ContentControl>
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,16,0,0">
        <Button Name="TestButton" Classes="secondary" Width="210" Command="{Binding TestCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:Icon Data="{DynamicResource IconRefresh}" Width="14" Height="14" StrokeThickness="2.2"/>
            <TextBlock Text="{loc:T add.test}"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Name="CancelButton" Classes="link caps" Margin="0,0,22,0" VerticalAlignment="Center" Command="{Binding CancelCommand}">
          <TextBlock Text="{loc:T add.cancel}"/>
        </Button>
        <Button Grid.Column="3" Name="SaveButton" Width="172" Command="{Binding SaveCommand}">
          <TextBlock Text="{Binding SaveLabel}"/>
        </Button>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:RealmPortal.App.Controls"
             xmlns:dev="using:RealmPortal.App.Dev"
             x:Class="RealmPortal.App.Dev.GalleryView"
             Width="1100">
  <!--
    Development-only component gallery (English labels on purpose: it is not part of the product UI).
    Every themed control in every state; states that need the pointer or keyboard are pinned with dev:ForceState.
    Generated once and then edited by hand.
  -->
  <UserControl.Styles>
    <Style Selector="Border.surface"><Setter Property="Background" Value="{DynamicResource Leather950Brush}"/><Setter Property="BorderBrush" Value="{DynamicResource BronzeDarkBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="24"/></Style>
    <Style Selector="TextBlock.heading"><Setter Property="FontFamily" Value="{DynamicResource FontCaps}"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource BronzeLightBrush}"/><Setter Property="Margin" Value="0,8,0,10"/></Style>
  </UserControl.Styles>
  <StackPanel Margin="32" Spacing="8">
    <TextBlock Classes="h1" Text="Component gallery"/>
    <TextBlock Classes="footnote" Foreground="{DynamicResource BoneSoftBrush}" Text="Direction B, Parchment and bronze. Development screen: every control in every state."/>

    <TextBlock Classes="heading" Text="BUTTONS"/>
    <Border Classes="surface"><StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="28" Margin="0,0,0,18"><TextBlock Classes="footnote" Width="90" VerticalAlignment="Bottom" Foreground="{DynamicResource BoneSoftBrush}" Text="primary"/><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Normal"/><Button ><StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{DynamicResource IconPlay}" IsFilled="True" Width="12" Height="12"/><TextBlock Text="Label"/></StackPanel></Button></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Hover"/><Button dev:ForceState.States=":pointerover" ><StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{DynamicResource IconPlay}" IsFilled="True" Width="12" Height="12"/><TextBlock Text="Label"/></StackPanel></Button></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Pressed"/><Button dev:ForceState.States=":pointerover :pressed" ><StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{DynamicResource IconPlay}" IsFilled="True" Width="12" Height="12"/><TextBlock Text="Label"/></StackPanel></Button></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Disabled"/><Button IsEnabled="False" ><StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{DynamicResource IconPlay}" IsFilled="True" Width="12" Height="12"/><TextBlock Text="Label"/></StackPanel></Button></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Focus"/><Button dev:ForceState.States=":focus-visible" ><StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{DynamicResource IconPlay}" IsFilled="True" Width="12" Height="12"/><TextBlock Text="Label"/></StackPanel></Button></StackPanel></StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="28" Margin="0,0,0,18"><TextBlock Classes="footnote" Width="90" VerticalAlignment="Bottom" Foreground="{DynamicResource BoneSoftBrush}" Text="secondary"/><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Normal"/><Button Classes="secondary" ><StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{DynamicResource IconPlay}" IsFilled="True" Width="12" Height="12"/><TextBlock Text="Label"/></StackPanel></Button></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Hover"/><Button Classes="secondary" dev:ForceState.States=":pointerover" ><StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{DynamicResource IconPlay}" IsFilled="True" Width="12" Height="12"/><TextBlock Text="Label"/></StackPanel></Button></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Pressed"/><Button Classes="secondary" dev:ForceState.States=":pointerover :pressed" ><StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{DynamicResource IconPlay}" IsFilled="True" Width="12" Height="12"/><TextBlock Text="Label"/></StackPanel></Button></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Disabled"/><Button Classes="secondary" IsEnabled="False" ><StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{DynamicResource IconPlay}" IsFilled="True" Width="12" Height="12"/><TextBlock Text="Label"/></StackPanel></Button></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Focus"/><Button Classes="secondary" dev:ForceState.States=":focus-visible" ><StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{DynamicResource IconPlay}" IsFilled="True" Width="12" Height="12"/><TextBlock Text="Label"/></StackPanel></Button></StackPanel></StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="28" Margin="0,0,0,18"><TextBlock Classes="footnote" Width="90" VerticalAlignment="Bottom" Foreground="{DynamicResource BoneSoftBrush}" Text="ghost"/><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Normal"/><Button Classes="ghost" ><StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{DynamicResource IconPlay}" IsFilled="True" Width="12" Height="12"/><TextBlock Text="Label"/></StackPanel></Button></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Hover"/><Button Classes="ghost" dev:ForceState.States=":pointerover" ><StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{DynamicResource IconPlay}" IsFilled="True" Width="12" Height="12"/><TextBlock Text="Label"/></StackPanel></Button></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Pressed"/><Button Classes="ghost" dev:ForceState.States=":pointerover :pressed" ><StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{DynamicResource IconPlay}" IsFilled="True" Width="12" Height="12"/><TextBlock Text="Label"/></StackPanel></Button></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Disabled"/><Button Classes="ghost" IsEnabled="False" ><StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{DynamicResource IconPlay}" IsFilled="True" Width="12" Height="12"/><TextBlock Text="Label"/></StackPanel></Button></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Focus"/><Button Classes="ghost" dev:ForceState.States=":focus-visible" ><StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{DynamicResource IconPlay}" IsFilled="True" Width="12" Height="12"/><TextBlock Text="Label"/></StackPanel></Button></StackPanel></StackPanel>
    </StackPanel></Border>
    <Border Background="{DynamicResource ParchmentPaperBrush}" Padding="24" Margin="0,8,0,0"><StackPanel Spacing="6">
      <TextBlock Classes="path" Foreground="{DynamicResource InkSoftBrush}" Text="ghost on parchment"/>
      <StackPanel Orientation="Horizontal" Spacing="28"><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource InkSoftBrush}" Text="Normal"/><Button Classes="ghost parchment" ><StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{DynamicResource IconPlay}" IsFilled="True" Width="12" Height="12"/><TextBlock Text="Label"/></StackPanel></Button></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource InkSoftBrush}" Text="Hover"/><Button Classes="ghost parchment" dev:ForceState.States=":pointerover" ><StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{DynamicResource IconPlay}" IsFilled="True" Width="12" Height="12"/><TextBlock Text="Label"/></StackPanel></Button></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource InkSoftBrush}" Text="Pressed"/><Button Classes="ghost parchment" dev:ForceState.States=":pointerover :pressed" ><StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{DynamicResource IconPlay}" IsFilled="True" Width="12" Height="12"/><TextBlock Text="Label"/></StackPanel></Button></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource InkSoftBrush}" Text="Disabled"/><Button Classes="ghost parchment" IsEnabled="False" ><StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{DynamicResource IconPlay}" IsFilled="True" Width="12" Height="12"/><TextBlock Text="Label"/></StackPanel></Button></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource InkSoftBrush}" Text="Focus"/><Button Classes="ghost parchment" dev:ForceState.States=":focus-visible" ><StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{DynamicResource IconPlay}" IsFilled="True" Width="12" Height="12"/><TextBlock Text="Label"/></StackPanel></Button></StackPanel></StackPanel>
    </StackPanel></Border>
    <Border Classes="surface" Margin="0,8,0,0"><StackPanel Spacing="14">
      <TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="split button (two plates: the joined plate is an art gap) - primary"/>
      <StackPanel Orientation="Horizontal" Spacing="28"><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Normal"/><StackPanel Orientation="Horizontal" Spacing="4"><Button Width="130"><StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{DynamicResource IconPlay}" IsFilled="True" Width="12" Height="12"/><TextBlock Text="Play"/></StackPanel></Button><Button Width="40" Padding="0" AutomationProperties.Name="More actions"><c:Icon Data="{DynamicResource IconChevronDown}" StrokeThickness="2.2"/></Button></StackPanel></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Hover"/><StackPanel Orientation="Horizontal" Spacing="4"><Button dev:ForceState.States=":pointerover" Width="130"><StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{DynamicResource IconPlay}" IsFilled="True" Width="12" Height="12"/><TextBlock Text="Play"/></StackPanel></Button><Button dev:ForceState.States=":pointerover" Width="40" Padding="0" AutomationProperties.Name="More actions"><c:Icon Data="{DynamicResource IconChevronDown}" StrokeThickness="2.2"/></Button></StackPanel></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Pressed"/><StackPanel Orientation="Horizontal" Spacing="4"><Button dev:ForceState.States=":pointerover :pressed" Width="130"><StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{DynamicResource IconPlay}" IsFilled="True" Width="12" Height="12"/><TextBlock Text="Play"/></StackPanel></Button><Button dev:ForceState.States=":pointerover :pressed" Width="40" Padding="0" AutomationProperties.Name="More actions"><c:Icon Data="{DynamicResource IconChevronDown}" StrokeThickness="2.2"/></Button></StackPanel></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Disabled"/><StackPanel Orientation="Horizontal" Spacing="4"><Button IsEnabled="False" Width="130"><StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{DynamicResource IconPlay}" IsFilled="True" Width="12" Height="12"/><TextBlock Text="Play"/></StackPanel></Button><Button IsEnabled="False" Width="40" Padding="0" AutomationProperties.Name="More actions"><c:Icon Data="{DynamicResource IconChevronDown}" StrokeThickness="2.2"/></Button></StackPanel></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Focus"/><StackPanel Orientation="Horizontal" Spacing="4"><Button dev:ForceState.States=":focus-visible" Width="130"><StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{DynamicResource IconPlay}" IsFilled="True" Width="12" Height="12"/><TextBlock Text="Play"/></StackPanel></Button><Button dev:ForceState.States=":focus-visible" Width="40" Padding="0" AutomationProperties.Name="More actions"><c:Icon Data="{DynamicResource IconChevronDown}" StrokeThickness="2.2"/></Button></StackPanel></StackPanel></StackPanel>
      <TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="split button - secondary"/>
      <StackPanel Orientation="Horizontal" Spacing="28"><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Normal"/><StackPanel Orientation="Horizontal" Spacing="4"><Button Classes="secondary" Width="130"><StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{DynamicResource IconPlay}" IsFilled="True" Width="12" Height="12"/><TextBlock Text="Play"/></StackPanel></Button><Button Classes="secondary" Width="40" Padding="0" AutomationProperties.Name="More actions"><c:Icon Data="{DynamicResource IconChevronDown}" StrokeThickness="2.2"/></Button></StackPanel></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Hover"/><StackPanel Orientation="Horizontal" Spacing="4"><Button Classes="secondary" dev:ForceState.States=":pointerover" Width="130"><StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{DynamicResource IconPlay}" IsFilled="True" Width="12" Height="12"/><TextBlock Text="Play"/></StackPanel></Button><Button Classes="secondary" dev:ForceState.States=":pointerover" Width="40" Padding="0" AutomationProperties.Name="More actions"><c:Icon Data="{DynamicResource IconChevronDown}" StrokeThickness="2.2"/></Button></StackPanel></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Pressed"/><StackPanel Orientation="Horizontal" Spacing="4"><Button Classes="secondary" dev:ForceState.States=":pointerover :pressed" Width="130"><StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{DynamicResource IconPlay}" IsFilled="True" Width="12" Height="12"/><TextBlock Text="Play"/></StackPanel></Button><Button Classes="secondary" dev:ForceState.States=":pointerover :pressed" Width="40" Padding="0" AutomationProperties.Name="More actions"><c:Icon Data="{DynamicResource IconChevronDown}" StrokeThickness="2.2"/></Button></StackPanel></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Disabled"/><StackPanel Orientation="Horizontal" Spacing="4"><Button Classes="secondary" IsEnabled="False" Width="130"><StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{DynamicResource IconPlay}" IsFilled="True" Width="12" Height="12"/><TextBlock Text="Play"/></StackPanel></Button><Button Classes="secondary" IsEnabled="False" Width="40" Padding="0" AutomationProperties.Name="More actions"><c:Icon Data="{DynamicResource IconChevronDown}" StrokeThickness="2.2"/></Button></StackPanel></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Focus"/><StackPanel Orientation="Horizontal" Spacing="4"><Button Classes="secondary" dev:ForceState.States=":focus-visible" Width="130"><StackPanel Orientation="Horizontal" Spacing="8"><c:Icon Data="{DynamicResource IconPlay}" IsFilled="True" Width="12" Height="12"/><TextBlock Text="Play"/></StackPanel></Button><Button Classes="secondary" dev:ForceState.States=":focus-visible" Width="40" Padding="0" AutomationProperties.Name="More actions"><c:Icon Data="{DynamicResource IconChevronDown}" StrokeThickness="2.2"/></Button></StackPanel></StackPanel></StackPanel>
      <TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="widths: 100 / 160 / 240 / 400 (stretch limit) and compact 36 px"/>
      <StackPanel Orientation="Horizontal" Spacing="20">
        <Button Width="100"><TextBlock Text="Short"/></Button><Button Width="160"><TextBlock Text="Native size"/></Button><Button Width="240"><TextBlock Text="Wide"/></Button><Button Width="400" Classes="secondary"><TextBlock Text="Stretched far"/></Button><Button Classes="compact"><TextBlock Text="Compact"/></Button>
      </StackPanel>
    </StackPanel></Border>

    <TextBlock Classes="heading" Text="SEALS AND BADGES"/>
    <Border Classes="surface"><StackPanel Spacing="18">
      <StackPanel Orientation="Horizontal" Spacing="22" VerticalAlignment="Center"><c:Seal Status="Active" Width="32" Height="32"/><c:Seal Status="Ready" Width="32" Height="32"/><c:Seal Status="Incompatible" Width="32" Height="32"/><c:Seal Status="NoResponse" Width="32" Height="32"/><c:Seal Status="Inactive" Width="32" Height="32"/><Rectangle Width="20"/><c:Seal Status="Active" Width="48" Height="48"/><c:Seal Status="Ready" Width="48" Height="48"/><c:Seal Status="Incompatible" Width="48" Height="48"/><c:Seal Status="NoResponse" Width="48" Height="48"/><c:Seal Status="Inactive" Width="48" Height="48"/><Rectangle Width="20"/><c:Seal Status="Active" Width="64" Height="64"/><c:Seal Status="Ready" Width="64" Height="64"/><c:Seal Status="Incompatible" Width="64" Height="64"/><c:Seal Status="NoResponse" Width="64" Height="64"/><c:Seal Status="Inactive" Width="64" Height="64"/></StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="14"><c:Badge Status="Active" Text="Active"/><c:Badge Status="Ready" Text="Ready"/><c:Badge Status="Incompatible" Text="Incompatible"/><c:Badge Status="NoResponse" Text="No response"/><c:Badge Status="Inactive" Text="Inactive"/></StackPanel>
      <Border Background="{DynamicResource ParchmentPaperBrush}" Padding="16"><StackPanel Orientation="Horizontal" Spacing="14"><c:Badge Status="Active" Text="Active"/><c:Badge Status="Ready" Text="Ready"/><c:Badge Status="Incompatible" Text="Incompatible"/><c:Badge Status="NoResponse" Text="No response"/><c:Badge Status="Inactive" Text="Inactive"/></StackPanel></Border>
    </StackPanel></Border>

    <TextBlock Classes="heading" Text="TEXT FIELDS"/>
    <Border Classes="surface"><StackPanel Orientation="Horizontal" Spacing="20"><StackPanel Spacing="6" Width="226"><TextBlock Classes="body-bold" Foreground="{DynamicResource BoneBrush}" Text="Label"/><TextBox Text="logon.example.com"/><StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Data="{DynamicResource IconInfo}" Width="13" Height="13" Foreground="{DynamicResource BoneSoftBrush}" StrokeThickness="2"/><TextBlock Classes="footnote" Foreground="{DynamicResource BoneSoftBrush}" Text="Help text"/></StackPanel></StackPanel><StackPanel Spacing="6" Width="226"><TextBlock Classes="body-bold" Foreground="{DynamicResource BoneBrush}" Text="Label (focus)"/><TextBox dev:ForceState.States=":focus" Text="logon.example.com"/><StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Data="{DynamicResource IconInfo}" Width="13" Height="13" Foreground="{DynamicResource BoneSoftBrush}" StrokeThickness="2"/><TextBlock Classes="footnote" Foreground="{DynamicResource BoneSoftBrush}" Text="Help text"/></StackPanel></StackPanel><StackPanel Spacing="6" Width="226"><TextBlock Classes="body-bold" Foreground="{DynamicResource BoneBrush}" Text="Label (error)"/><TextBox Classes="error" Text="logon.example.com"/><StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Data="{DynamicResource IconError}" Width="13" Height="13" Foreground="{DynamicResource WaxLightBrush}" StrokeThickness="2"/><TextBlock Classes="footnote" Foreground="{DynamicResource WaxLightBrush}" Text="This address is not valid"/></StackPanel></StackPanel><StackPanel Spacing="6" Width="226"><TextBlock Classes="body-bold" Foreground="{DynamicResource MutedBrush}" Text="Label (disabled)"/><TextBox IsEnabled="False" Text="logon.example.com"/><StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Data="{DynamicResource IconInfo}" Width="13" Height="13" Foreground="{DynamicResource MutedBrush}" StrokeThickness="2"/><TextBlock Classes="footnote" Foreground="{DynamicResource MutedBrush}" Text="Help text"/></StackPanel></StackPanel></StackPanel></Border>
    <Border Background="{DynamicResource ParchmentPaperBrush}" Padding="24" Margin="0,8,0,0"><StackPanel Orientation="Horizontal" Spacing="20"><StackPanel Spacing="6" Width="226"><TextBlock Classes="body-bold" Foreground="{DynamicResource InkBrush}" Text="Label"/><TextBox Classes="parchment" Text="logon.example.com"/><StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Data="{DynamicResource IconInfo}" Width="13" Height="13" Foreground="{DynamicResource InkSoftBrush}" StrokeThickness="2"/><TextBlock Classes="footnote" Foreground="{DynamicResource InkSoftBrush}" Text="Help text"/></StackPanel></StackPanel><StackPanel Spacing="6" Width="226"><TextBlock Classes="body-bold" Foreground="{DynamicResource InkBrush}" Text="Label (focus)"/><TextBox Classes="parchment" dev:ForceState.States=":focus" Text="logon.example.com"/><StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Data="{DynamicResource IconInfo}" Width="13" Height="13" Foreground="{DynamicResource InkSoftBrush}" StrokeThickness="2"/><TextBlock Classes="footnote" Foreground="{DynamicResource InkSoftBrush}" Text="Help text"/></StackPanel></StackPanel><StackPanel Spacing="6" Width="226"><TextBlock Classes="body-bold" Foreground="{DynamicResource InkBrush}" Text="Label (error)"/><TextBox Classes="parchment error" Text="logon.example.com"/><StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Data="{DynamicResource IconError}" Width="13" Height="13" Foreground="{DynamicResource WaxTextBrush}" StrokeThickness="2"/><TextBlock Classes="footnote" Foreground="{DynamicResource WaxTextBrush}" Text="This address is not valid"/></StackPanel></StackPanel><StackPanel Spacing="6" Width="226"><TextBlock Classes="body-bold" Foreground="{DynamicResource MutedBrush}" Text="Label (disabled)"/><TextBox Classes="parchment" IsEnabled="False" Text="logon.example.com"/><StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Data="{DynamicResource IconInfo}" Width="13" Height="13" Foreground="{DynamicResource MutedBrush}" StrokeThickness="2"/><TextBlock Classes="footnote" Foreground="{DynamicResource MutedBrush}" Text="Help text"/></StackPanel></StackPanel></StackPanel></Border>

    <TextBlock Classes="heading" Text="CHECK BOX, RADIO BUTTON, SWITCH"/>
    <Border Classes="surface"><StackPanel Spacing="20"><StackPanel Orientation="Horizontal" Spacing="22"><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Off"/><CheckBox Content="Option"/></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Off, hover"/><CheckBox dev:ForceState.States=":pointerover" Content="Option"/></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Off, focus"/><CheckBox dev:ForceState.States=":focus-visible" Content="Option"/></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Off, disabled"/><CheckBox IsEnabled="False" Content="Option"/></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="On"/><CheckBox IsChecked="True" Content="Option"/></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="On, hover"/><CheckBox dev:ForceState.States=":pointerover" IsChecked="True" Content="Option"/></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="On, focus"/><CheckBox dev:ForceState.States=":focus-visible" IsChecked="True" Content="Option"/></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="On, disabled"/><CheckBox IsEnabled="False" IsChecked="True" Content="Option"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal" Spacing="22"><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Off"/><RadioButton Content="Option"/></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Off, hover"/><RadioButton dev:ForceState.States=":pointerover" Content="Option"/></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Off, focus"/><RadioButton dev:ForceState.States=":focus-visible" Content="Option"/></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Off, disabled"/><RadioButton IsEnabled="False" Content="Option"/></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="On"/><RadioButton IsChecked="True" Content="Option"/></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="On, hover"/><RadioButton dev:ForceState.States=":pointerover" IsChecked="True" Content="Option"/></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="On, focus"/><RadioButton dev:ForceState.States=":focus-visible" IsChecked="True" Content="Option"/></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="On, disabled"/><RadioButton IsEnabled="False" IsChecked="True" Content="Option"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal" Spacing="22"><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Off"/><ToggleButton Classes="switch" AutomationProperties.Name="Switch"/></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Off, hover"/><ToggleButton Classes="switch" dev:ForceState.States=":pointerover" AutomationProperties.Name="Switch"/></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Off, focus"/><ToggleButton Classes="switch" dev:ForceState.States=":focus-visible" AutomationProperties.Name="Switch"/></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="Off, disabled"/><ToggleButton Classes="switch" IsEnabled="False" AutomationProperties.Name="Switch"/></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="On"/><ToggleButton Classes="switch" IsChecked="True" AutomationProperties.Name="Switch"/></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="On, hover"/><ToggleButton Classes="switch" dev:ForceState.States=":pointerover" IsChecked="True" AutomationProperties.Name="Switch"/></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="On, focus"/><ToggleButton Classes="switch" dev:ForceState.States=":focus-visible" IsChecked="True" AutomationProperties.Name="Switch"/></StackPanel><StackPanel Spacing="6"><TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="On, disabled"/><ToggleButton Classes="switch" IsEnabled="False" IsChecked="True" AutomationProperties.Name="Switch"/></StackPanel></StackPanel></StackPanel></Border>

    <TextBlock Classes="heading" Text="PANELS AND CARDS"/>
    <Border Classes="surface"><StackPanel Spacing="28">
      <ListBox Classes="cards" SelectionMode="Single">
        <ListBoxItem IsSelected="True"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16"><c:Seal Status="Active" Width="48" Height="48" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock Classes="h2" Text="My server"/><TextBlock Classes="address" Foreground="{DynamicResource InkSoftBrush}" Text="logon.example.com"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"><c:Badge Status="Active" Text="Active"/><Button Classes="compact" Width="110"><TextBlock Text="Play"/></Button></StackPanel></Grid></ListBoxItem>
        <ListBoxItem dev:ForceState.States=":pointerover"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16"><c:Seal Status="Ready" Width="48" Height="48" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock Classes="h2" Text="Hovered card"/><TextBlock Classes="address" Foreground="{DynamicResource InkSoftBrush}" Text="127.0.0.1"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"><c:Badge Status="Ready" Text="Ready"/><Button Classes="compact" Width="110"><TextBlock Text="Play"/></Button></StackPanel></Grid></ListBoxItem>
        <ListBoxItem dev:ForceState.States=":focus-visible"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16"><c:Seal Status="Incompatible" Width="48" Height="48" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock Classes="h2" Text="Keyboard focus"/><TextBlock Classes="address" Foreground="{DynamicResource InkSoftBrush}" Text="logon.other.net"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"><c:Badge Status="Incompatible" Text="Incompatible"/><Button Classes="compact" Width="110"><TextBlock Text="Play"/></Button></StackPanel></Grid></ListBoxItem>
        <ListBoxItem><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16"><c:Seal Status="NoResponse" Width="48" Height="48" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock Classes="h2" Text="No answer"/><TextBlock Classes="address" Foreground="{DynamicResource InkSoftBrush}" Text="logon.gone.org"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"><c:Badge Status="NoResponse" Text="No response"/><Button Classes="compact" Width="110"><TextBlock Text="Play"/></Button></StackPanel></Grid></ListBoxItem>
      </ListBox>
      <StackPanel Orientation="Horizontal" Spacing="40">
        <ContentControl Classes="card medium" Width="360" Height="260"><StackPanel Spacing="8"><TextBlock Classes="h2" Text="Medium panel"/><TextBlock Classes="body" TextWrapping="Wrap" Text="384x284 art. Torn parchment edge, 12 px baked shadow."/></StackPanel></ContentControl>
        <ContentControl Classes="card medium active" Width="360" Height="260"><StackPanel Spacing="8"><TextBlock Classes="h2" Text="Active medium panel"/><TextBlock Classes="body" TextWrapping="Wrap" Text="Same size, active art with the bronze corners."/></StackPanel></ContentControl>
      </StackPanel>
      <TextBlock Classes="path" Foreground="{DynamicResource BoneSoftBrush}" Text="row heights near the art limit: body 48 / 56 / 72 px (a thin panel is an art gap)"/>
      <StackPanel Spacing="22">
        <ContentControl Classes="card" Height="48" Padding="28,0" Width="500" HorizontalAlignment="Left"><TextBlock Classes="body-bold" VerticalAlignment="Center" Text="48 px body"/></ContentControl>
        <ContentControl Classes="card" Height="56" Padding="28,0" Width="500" HorizontalAlignment="Left"><TextBlock Classes="body-bold" VerticalAlignment="Center" Text="56 px body"/></ContentControl>
        <ContentControl Classes="card" Height="72" Padding="28,0" Width="500" HorizontalAlignment="Left"><TextBlock Classes="body-bold" VerticalAlignment="Center" Text="72 px body"/></ContentControl>
      </StackPanel>
    </StackPanel></Border>

    <TextBlock Classes="heading" Text="NAVIGATION TABS"/>
    <Border Classes="surface"><StackPanel Orientation="Horizontal" Spacing="48">
      <ListBox Classes="nav" Width="200" SelectedIndex="0">
        <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="12"><c:Icon Data="{DynamicResource IconServers}" Width="18" Height="18"/><TextBlock Text="Servers"/></StackPanel></ListBoxItem><ListBoxItem dev:ForceState.States=":pointerover"><StackPanel Orientation="Horizontal" Spacing="12"><c:Icon Data="{DynamicResource IconFolder}" Width="18" Height="18"/><TextBlock Text="Clients (hover)"/></StackPanel></ListBoxItem><ListBoxItem dev:ForceState.States=":focus-visible"><StackPanel Orientation="Horizontal" Spacing="12"><c:Icon Data="{DynamicResource IconGear}" Width="18" Height="18"/><TextBlock Text="Settings (focus)"/></StackPanel></ListBoxItem><ListBoxItem><StackPanel Orientation="Horizontal" Spacing="12"><c:Icon Data="{DynamicResource IconInfo}" Width="18" Height="18"/><TextBlock Text="About"/></StackPanel></ListBoxItem>
      </ListBox>
      <ListBox Classes="nav" Width="200" SelectedIndex="2">
        <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="12"><c:Icon Data="{DynamicResource IconServers}" Width="18" Height="18"/><TextBlock Text="Servers"/></StackPanel></ListBoxItem><ListBoxItem><StackPanel Orientation="Horizontal" Spacing="12"><c:Icon Data="{DynamicResource IconFolder}" Width="18" Height="18"/><TextBlock Text="Clients"/></StackPanel></ListBoxItem><ListBoxItem dev:ForceState.States=":focus-visible"><StackPanel Orientation="Horizontal" Spacing="12"><c:Icon Data="{DynamicResource IconGear}" Width="18" Height="18"/><TextBlock Text="Settings (sel, focus)"/></StackPanel></ListBoxItem><ListBoxItem><StackPanel Orientation="Horizontal" Spacing="12"><c:Icon Data="{DynamicResource IconInfo}" Width="18" Height="18"/><TextBlock Text="About"/></StackPanel></ListBoxItem>
      </ListBox>
      <ListBox Classes="nav compact" Width="56" SelectedIndex="1">
        <ListBoxItem><c:Icon Data="{DynamicResource IconServers}" Width="18" Height="18"/></ListBoxItem><ListBoxItem><c:Icon Data="{DynamicResource IconFolder}" Width="18" Height="18"/></ListBoxItem><ListBoxItem dev:ForceState.States=":pointerover"><c:Icon Data="{DynamicResource IconGear}" Width="18" Height="18"/></ListBoxItem><ListBoxItem dev:ForceState.States=":focus-visible"><c:Icon Data="{DynamicResource IconInfo}" Width="18" Height="18"/></ListBoxItem>
      </ListBox>
    </StackPanel></Border>

    <TextBlock Classes="heading" Text="TYPOGRAPHY"/>
    <Border Classes="surface"><StackPanel Spacing="8">
      <TextBlock Classes="display" Text="Display 34 - Almendra Bold"/>
      <TextBlock Classes="h1" Text="H1 28 - Almendra Bold"/>
      <TextBlock Classes="h2" Text="H2 20 - Server name"/>
      <TextBlock Classes="dropcap" Text="R"/>
      <TextBlock Classes="button" Text="Button 14 - Marcellus SC"/>
      <TextBlock Classes="section" Foreground="{DynamicResource BronzeLightBrush}" Text="Section 13 - Marcellus SC"/>
      <TextBlock Classes="body" Text="Body 17 - Alegreya. ¿Qué sello será? ¡Áéíóú ñ ü Ñ!"/>
      <TextBlock Classes="body-sm" Text="Body 16 - Alegreya Regular"/>
      <TextBlock Classes="body-medium" Text="Body medium 16 - Alegreya Medium"/>
      <TextBlock Classes="body-bold" Text="Body bold 15 - Alegreya Bold"/>
      <TextBlock Classes="footnote" Text="Footnote 13 - Alegreya Sans Medium"/>
      <TextBlock Classes="status" Text="STATUS 12 - ALEGREYA SANS BOLD"/>
      <TextBlock Classes="address" Text="logon.example.com:3724  (address 13, JetBrains Mono)"/>
      <TextBlock Classes="path" Text="/home/user/games/wow-3.3.5/Wow.exe  (path 12)"/>
    </StackPanel></Border>
    <Rectangle Height="16"/>
  </StackPanel>
</UserControl>

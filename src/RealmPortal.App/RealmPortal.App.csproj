<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>RealmPortal.App</RootNamespace>
    <AssemblyName>RealmPortal.App</AssemblyName>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\branding\icon\windows\realm-portal.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Simple" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RealmPortal.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RealmPortal.Core\RealmPortal.Core.csproj" />
  </ItemGroup>
  <ItemGroup Label="UI strings (Spanish and English), loaded by Localization/Loc.cs">
    <AvaloniaResource Include="Localization\Strings\*.json" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\branding\icon\png\realm-portal-256.png" Link="Assets/app-icon.png" />
  </ItemGroup>
  <ItemGroup Label="Tesera icon sizes, drawn natively per size (micro, simplified, full); used for _NET_WM_ICON on X11">
    <AvaloniaResource Include="..\..\assets\branding\icon\png\realm-portal-*.png" Exclude="..\..\assets\branding\icon\png\realm-portal-512.png" Link="Assets/Icons/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Label="UI kit art (assets/ui, flattened to Assets/Ui), seals and textures. The legacy assets/frames are not bundled; the app keeps the system title bar, so no window frame.">
    <AvaloniaResource Include="..\..\assets\ui\**\*.png" Link="Assets/Ui/%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\..\assets\icons\seals\*-64.png;..\..\assets\icons\seals\*-128.png" Link="Assets/Seals/%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\..\assets\textures\tex-leather.jpg" Link="Assets/Textures/tex-leather.jpg" />
  </ItemGroup>
  <ItemGroup Label="Bundled fonts (SIL OFL 1.1). Static instances only; the variable fonts in assets/fonts are not bundled.">
    <AvaloniaResource Include="..\..\assets\fonts\almendra\Almendra-Bold.ttf" Link="Assets/Fonts/Almendra-Bold.ttf" />
    <AvaloniaResource Include="..\..\assets\fonts\marcellussc\MarcellusSC-Regular.ttf" Link="Assets/Fonts/MarcellusSC-Regular.ttf" />
    <AvaloniaResource Include="..\..\assets\fonts\alegreya\Alegreya-Regular.ttf" Link="Assets/Fonts/Alegreya-Regular.ttf" />
    <AvaloniaResource Include="..\..\assets\fonts\alegreya\Alegreya-Medium.ttf" Link="Assets/Fonts/Alegreya-Medium.ttf" />
    <AvaloniaResource Include="..\..\assets\fonts\alegreya\Alegreya-Bold.ttf" Link="Assets/Fonts/Alegreya-Bold.ttf" />
    <AvaloniaResource Include="..\..\assets\fonts\alegreyasans\AlegreyaSans-Regular.ttf" Link="Assets/Fonts/AlegreyaSans-Regular.ttf" />
    <AvaloniaResource Include="..\..\assets\fonts\alegreyasans\AlegreyaSans-Medium.ttf" Link="Assets/Fonts/AlegreyaSans-Medium.ttf" />
    <AvaloniaResource Include="..\..\assets\fonts\alegreyasans\AlegreyaSans-Bold.ttf" Link="Assets/Fonts/AlegreyaSans-Bold.ttf" />
    <AvaloniaResource Include="..\..\assets\fonts\jetbrainsmono\JetBrainsMono-Regular.ttf" Link="Assets/Fonts/JetBrainsMono-Regular.ttf" />
    <AvaloniaResource Include="..\..\assets\fonts\almendra\OFL.txt" Link="Assets/Fonts/licenses/OFL-Almendra.txt" />
    <AvaloniaResource Include="..\..\assets\fonts\marcellussc\OFL.txt" Link="Assets/Fonts/licenses/OFL-MarcellusSC.txt" />
    <AvaloniaResource Include="..\..\assets\fonts\alegreya\OFL.txt" Link="Assets/Fonts/licenses/OFL-Alegreya.txt" />
    <AvaloniaResource Include="..\..\assets\fonts\alegreyasans\OFL.txt" Link="Assets/Fonts/licenses/OFL-AlegreyaSans.txt" />
    <AvaloniaResource Include="..\..\assets\fonts\jetbrainsmono\OFL.txt" Link="Assets/Fonts/licenses/OFL-JetBrainsMono.txt" />
  </ItemGroup>
</Project>

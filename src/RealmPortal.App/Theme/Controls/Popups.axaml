<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:RealmPortal.App.Controls"
        x:CompileBindings="False">
  <!--
    Popups: ComboBox, menus (MenuFlyout / ContextMenu / the split-button menu) and tooltips.
    NO kit art exists for these (ART-GAPS.md): they use the closest pieces, the 96x64 popup plates (popup-leather,
    popup-parchment; insets 16), the input plates for the ComboBox box, and a FLAT hover (designer decision, no texture): a solid token fill
    at 14 % (bronze over leather, wax red over parchment) plus a 3 px wax-red bar on the left edge as a second signal.
    Leather by default; add class "parchment" (on the ComboBox, or via FlyoutPresenterClasses on a MenuFlyout) for parchment.
    The popup plates have no shadow layer yet: a popup window clips anything outside its content.
  -->
  <Styles.Resources>
    <!-- Flat hover fills: bronze 14 % over leather popups, wax red 14 % over parchment popups; "selected" is a little stronger. -->
    <SolidColorBrush x:Key="HoverFillLeatherBrush" Color="#24A8743F"/>
    <SolidColorBrush x:Key="SelectedFillLeatherBrush" Color="#3DA8743F"/>
    <SolidColorBrush x:Key="HoverFillParchmentBrush" Color="#247A2723"/>
    <SolidColorBrush x:Key="SelectedFillParchmentBrush" Color="#3D7A2723"/>
    <ControlTheme x:Key="RpToolTip" TargetType="ToolTip">
      <Setter Property="Foreground" Value="{DynamicResource BoneBrush}"/>
      <Setter Property="FontFamily" Value="{DynamicResource FontBody}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="MaxWidth" Value="320"/>
      <Setter Property="Template">
        <ControlTemplate>
          <c:NineSlice Source="popup-leather" Insets="16">
            <ContentPresenter Name="PART_ContentPresenter" Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
          </c:NineSlice>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="RpMenuFlyoutPresenter" TargetType="MenuFlyoutPresenter">
      <Setter Property="Foreground" Value="{DynamicResource BoneBrush}"/>
      <Setter Property="FontFamily" Value="{DynamicResource FontBody}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Padding" Value="6"/>
      <Setter Property="MinWidth" Value="160"/>
      <Setter Property="Template">
        <ControlTemplate>
          <c:NineSlice Name="Plate" Source="popup-leather" Insets="16">
            <ItemsPresenter Name="PART_ItemsPresenter" Margin="{TemplateBinding Padding}" Grid.IsSharedSizeScope="True"
                            ItemsPanel="{TemplateBinding ItemsPanel}" KeyboardNavigation.TabNavigation="Continue"/>
          </c:NineSlice>
        </ControlTemplate>
      </Setter>
      <Style Selector="^.parchment"><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/></Style>
      <Style Selector="^.parchment /template/ c|NineSlice#Plate"><Setter Property="Source" Value="popup-parchment"/></Style>
    </ControlTheme>

    <ControlTheme x:Key="RpContextMenu" TargetType="ContextMenu">
      <Setter Property="Foreground" Value="{DynamicResource BoneBrush}"/>
      <Setter Property="FontFamily" Value="{DynamicResource FontBody}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Padding" Value="6"/>
      <Setter Property="MinWidth" Value="160"/>
      <Setter Property="Template">
        <ControlTemplate>
          <c:NineSlice Name="Plate" Source="popup-leather" Insets="16">
            <ItemsPresenter Name="PART_ItemsPresenter" Margin="{TemplateBinding Padding}" Grid.IsSharedSizeScope="True"
                            ItemsPanel="{TemplateBinding ItemsPanel}" KeyboardNavigation.TabNavigation="Continue"/>
          </c:NineSlice>
        </ControlTemplate>
      </Setter>
      <Style Selector="^.parchment"><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/></Style>
      <Style Selector="^.parchment /template/ c|NineSlice#Plate"><Setter Property="Source" Value="popup-parchment"/></Style>
    </ControlTheme>

    <ControlTheme x:Key="RpMenuItem" TargetType="MenuItem">
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Root" CornerRadius="{DynamicResource RadiusControl}" Background="Transparent" Padding="{TemplateBinding Padding}">
            <Panel>
            <Border Name="Bar" Width="3" Margin="-10,-8,0,-8" HorizontalAlignment="Left" Background="{DynamicResource WaxHoverBrush}" Opacity="0" IsHitTestVisible="False"/>
            <Grid ColumnDefinitions="Auto,*" Margin="4,0,0,0">
              <ContentControl Name="PART_IconPresenter" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"
                              Content="{TemplateBinding Icon}"/>
              <ContentPresenter Name="PART_HeaderPresenter" Grid.Column="1" VerticalAlignment="Center"
                                Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                RecognizesAccessKey="True"/>
            </Grid>
            </Panel>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:selected /template/ Border#Root"><Setter Property="Background" Value="{DynamicResource HoverFillLeatherBrush}"/></Style>
      <Style Selector="^:selected /template/ Border#Bar"><Setter Property="Opacity" Value="1"/></Style>
      <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.5"/><Setter Property="Cursor" Value="Arrow"/></Style>
    </ControlTheme>

    <ControlTheme x:Key="RpComboBox" TargetType="ComboBox">
      <Setter Property="ClipToBounds" Value="False"/>
      <Setter Property="FontFamily" Value="{DynamicResource FontBody}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Foreground" Value="{DynamicResource BoneBrush}"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="12,0,6,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="MaxDropDownHeight" Value="240"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <c:NineSlice Name="Plate" Source="input-leather-normal" Insets="14" IsHitTestVisible="False"/>
            <Grid ColumnDefinitions="*,Auto" Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
              <TextBlock Name="PlaceholderTextBlock" VerticalAlignment="Center" Text="{TemplateBinding PlaceholderText}"
                         Foreground="{DynamicResource BoneSoftBrush}"
                         IsVisible="{TemplateBinding SelectionBoxItem, Converter={x:Static ObjectConverters.IsNull}}"/>
              <ContentControl HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
              <c:Icon Name="Chevron" Grid.Column="1" Data="{DynamicResource IconChevronDown}" Width="16" Height="16" StrokeThickness="2.2"
                      Margin="8,0,6,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
            </Grid>
            <ToggleButton Name="toggle" Background="Transparent" BorderThickness="0" ClickMode="Press" Focusable="False" Opacity="0"
                          IsChecked="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"/>
            <Popup Name="PART_Popup" MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                   MaxHeight="{TemplateBinding MaxDropDownHeight}" IsLightDismissEnabled="True"
                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}" PlacementTarget="{TemplateBinding}" InheritsTransform="True">
              <c:NineSlice Name="PopupPlate" Source="popup-leather" Insets="16">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="6">
                  <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
                </ScrollViewer>
              </c:NineSlice>
            </Popup>
          </Panel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ c|NineSlice#Plate"><Setter Property="Source" Value="input-leather-hover"/></Style>
      <Style Selector="^:focus /template/ c|NineSlice#Plate"><Setter Property="Source" Value="input-leather-focus"/></Style>
      <Style Selector="^:dropdownopen /template/ c|NineSlice#Plate"><Setter Property="Source" Value="input-leather-focus"/></Style>
      <Style Selector="^.error /template/ c|NineSlice#Plate"><Setter Property="Source" Value="input-leather-error"/></Style>
      <Style Selector="^:disabled /template/ c|NineSlice#Plate"><Setter Property="Source" Value="input-leather-disabled"/></Style>
      <Style Selector="^:disabled"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Cursor" Value="Arrow"/></Style>
      <!-- parchment -->
      <Style Selector="^.parchment"><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/></Style>
      <Style Selector="^.parchment /template/ c|NineSlice#Plate"><Setter Property="Source" Value="input-parchment-normal"/></Style>
      <Style Selector="^.parchment:pointerover /template/ c|NineSlice#Plate"><Setter Property="Source" Value="input-parchment-hover"/></Style>
      <Style Selector="^.parchment:focus /template/ c|NineSlice#Plate"><Setter Property="Source" Value="input-parchment-focus"/></Style>
      <Style Selector="^.parchment:dropdownopen /template/ c|NineSlice#Plate"><Setter Property="Source" Value="input-parchment-focus"/></Style>
      <Style Selector="^.parchment.error /template/ c|NineSlice#Plate"><Setter Property="Source" Value="input-parchment-error"/></Style>
      <Style Selector="^.parchment:disabled /template/ c|NineSlice#Plate"><Setter Property="Source" Value="input-parchment-disabled"/></Style>
      <Style Selector="^.parchment /template/ c|NineSlice#PopupPlate"><Setter Property="Source" Value="popup-parchment"/></Style>
      <Style Selector="^.parchment /template/ TextBlock#PlaceholderTextBlock"><Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}"/></Style>
    </ControlTheme>

    <ControlTheme x:Key="RpComboBoxItem" TargetType="ComboBoxItem">
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Root" CornerRadius="{DynamicResource RadiusControl}" Background="Transparent">
            <Panel>
              <Border Name="Bar" Width="3" HorizontalAlignment="Left" Background="{DynamicResource WaxHoverBrush}" Opacity="0" IsHitTestVisible="False"/>
              <ContentPresenter Name="PART_ContentPresenter" Padding="{TemplateBinding Padding}" Margin="4,0,0,0"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
            </Panel>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#Root"><Setter Property="Background" Value="{DynamicResource HoverFillLeatherBrush}"/></Style>
      <Style Selector="^:pointerover /template/ Border#Bar"><Setter Property="Opacity" Value="1"/></Style>
      <Style Selector="^:selected /template/ Border#Root"><Setter Property="Background" Value="{DynamicResource SelectedFillLeatherBrush}"/></Style>
      <Style Selector="ComboBox.parchment ^:pointerover /template/ Border#Root"><Setter Property="Background" Value="{DynamicResource HoverFillParchmentBrush}"/></Style>
      <Style Selector="ComboBox.parchment ^:pointerover /template/ Border#Bar"><Setter Property="Background" Value="{DynamicResource WaxBrush}"/></Style>
      <Style Selector="ComboBox.parchment ^:selected /template/ Border#Root"><Setter Property="Background" Value="{DynamicResource SelectedFillParchmentBrush}"/></Style>
    </ControlTheme>
  </Styles.Resources>
  <Style Selector="ToolTip"><Setter Property="Theme" Value="{StaticResource RpToolTip}"/></Style>
  <Style Selector="MenuFlyoutPresenter"><Setter Property="Theme" Value="{StaticResource RpMenuFlyoutPresenter}"/></Style>
  <Style Selector="ContextMenu"><Setter Property="Theme" Value="{StaticResource RpContextMenu}"/></Style>
  <Style Selector="MenuItem"><Setter Property="Theme" Value="{StaticResource RpMenuItem}"/></Style>
  <Style Selector="ComboBox"><Setter Property="Theme" Value="{StaticResource RpComboBox}"/></Style>
  <Style Selector="ComboBoxItem"><Setter Property="Theme" Value="{StaticResource RpComboBoxItem}"/></Style>
  <!-- Two-line menu item (title + hint), as in the play menu mockup. -->
  <Style Selector="TextBlock.menu-title"><Setter Property="FontFamily" Value="{DynamicResource FontBodyMedium}"/><Setter Property="FontSize" Value="16"/></Style>
  <Style Selector="TextBlock.menu-hint"><Setter Property="FontFamily" Value="{DynamicResource FontBody}"/><Setter Property="FontSize" Value="13"/><Setter Property="Opacity" Value="0.8"/></Style>
  <Style Selector="MenuItem.two-line"><Setter Property="MinHeight" Value="52"/></Style>
  <Style Selector="Separator">
    <Setter Property="Height" Value="1"/><Setter Property="Margin" Value="8,2"/><Setter Property="Background" Value="#33000000"/>
  </Style>
  <!-- Flat hover inside a parchment menu. -->
  <Style Selector="MenuFlyoutPresenter.parchment MenuItem:selected /template/ Border#Root, ContextMenu.parchment MenuItem:selected /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource HoverFillParchmentBrush}"/>
  </Style>
  <Style Selector="MenuFlyoutPresenter.parchment MenuItem:selected /template/ Border#Bar, ContextMenu.parchment MenuItem:selected /template/ Border#Bar">
    <Setter Property="Background" Value="{DynamicResource WaxBrush}"/>
  </Style>
</Styles>

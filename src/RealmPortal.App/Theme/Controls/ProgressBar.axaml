<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:RealmPortal.App.Controls">
  <!--
    ProgressBar from the kit: 12 px track (progress-track, on leather only) with the 8 px bronze fill 2 px inside
    (progress-fill, width = value x (track - 4), at least 8 px). Class "switching" adds the running stripes overlay
    (progress-stripes-tile, shifted 0 to 12 px in a loop). Horizontal only; the kit has no parchment art for it.
  -->
  <Styles.Resources>
    <ControlTheme x:Key="RpProgressBar" TargetType="ProgressBar">
      <Setter Property="MinWidth" Value="48"/>
      <Setter Property="Height" Value="12"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <c:NineSlice Source="progress-track" Insets="6" IsHitTestVisible="False"/>
            <Panel Margin="2">
              <Border Name="PART_Indicator" HorizontalAlignment="Left" MinWidth="8" ClipToBounds="True">
                <Panel>
                  <c:NineSlice Source="progress-fill" Insets="4"/>
                  <c:StripeTile Name="Stripes" IsVisible="False"/>
                </Panel>
              </Border>
              <Border Name="PART_IndeterminateIndicator" IsVisible="False"/>
            </Panel>
          </Panel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^[Value=0] /template/ Border#PART_Indicator"><Setter Property="IsVisible" Value="False"/></Style>
      <Style Selector="^.switching /template/ c|StripeTile#Stripes">
        <Setter Property="IsVisible" Value="True"/>
        <Style.Animations>
          <Animation Duration="0:0:0.6" IterationCount="Infinite" Easing="LinearEasing">
            <KeyFrame Cue="0%"><Setter Property="Offset" Value="0"/></KeyFrame>
            <KeyFrame Cue="100%"><Setter Property="Offset" Value="12"/></KeyFrame>
          </Animation>
        </Style.Animations>
      </Style>
    </ControlTheme>
  </Styles.Resources>
  <Style Selector="ProgressBar"><Setter Property="Theme" Value="{StaticResource RpProgressBar}"/></Style>
</Styles>

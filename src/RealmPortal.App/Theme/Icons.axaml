<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    UI icons: the 23 line icons of assets/icons/ui converted to geometries on a 24x24 grid.
    Generated by tools/svg-icons-to-axaml.py (run it again if the SVGs change). Draw them with the Icon
    control, which strokes with the inherited Foreground, so one icon works on leather and on parchment.
    "IconPlay" and "IconDiamond" are filled shapes (Icon.IsFilled="True"); all others are strokes.
  -->
  <StreamGeometry x:Key="IconChevronDown">M6 9l6 6 6-6</StreamGeometry>
  <StreamGeometry x:Key="IconClock">M3.0,12.0 a9.0,9.0 0 1 0 18.0,0 a9.0,9.0 0 1 0 -18.0,0 z M12 7v5l3.5 2</StreamGeometry>
  <StreamGeometry x:Key="IconClose">M6 6l12 12M18 6L6 18</StreamGeometry>
  <StreamGeometry x:Key="IconCopy">M8.5,8.5 h11.0 v11.0 h-11.0 z M15.5 8.5V4.5h-11v11h4</StreamGeometry>
  <StreamGeometry x:Key="IconDiamond">M12 3l9 9-9 9-9-9z</StreamGeometry>
  <StreamGeometry x:Key="IconError">M3.0,12.0 a9.0,9.0 0 1 0 18.0,0 a9.0,9.0 0 1 0 -18.0,0 z M8.5 8.5l7 7M15.5 8.5l-7 7</StreamGeometry>
  <StreamGeometry x:Key="IconFolder">M3.5 6.5h6l2 2.5h9v9.5h-17z</StreamGeometry>
  <StreamGeometry x:Key="IconGear">M8.8,12.0 a3.2,3.2 0 1 0 6.4,0 a3.2,3.2 0 1 0 -6.4,0 z M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1</StreamGeometry>
  <StreamGeometry x:Key="IconGlobe">M3.0,12.0 a9.0,9.0 0 1 0 18.0,0 a9.0,9.0 0 1 0 -18.0,0 z M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18</StreamGeometry>
  <StreamGeometry x:Key="IconInfo">M3.0,12.0 a9.0,9.0 0 1 0 18.0,0 a9.0,9.0 0 1 0 -18.0,0 z M12 11v6M12 7.2v1.6</StreamGeometry>
  <StreamGeometry x:Key="IconList">M4 7h16M4 12h16M4 17h10</StreamGeometry>
  <StreamGeometry x:Key="IconLock">M5.0,10.5 h14.0 v10.0 h-14.0 z M8 10.5V8a4 4 0 018 0v2.5</StreamGeometry>
  <StreamGeometry x:Key="IconMaximize">M6.0,6.0 h12.0 v12.0 h-12.0 z</StreamGeometry>
  <StreamGeometry x:Key="IconMinimize">M6 17h12</StreamGeometry>
  <StreamGeometry x:Key="IconOk">M3.0,12.0 a9.0,9.0 0 1 0 18.0,0 a9.0,9.0 0 1 0 -18.0,0 z M7.5 12.3l3 3 6-6.3</StreamGeometry>
  <StreamGeometry x:Key="IconPencil">M4 20l1-4L16 5l3 3L8 19z</StreamGeometry>
  <StreamGeometry x:Key="IconPlay">M8 5l11 7-11 7z</StreamGeometry>
  <StreamGeometry x:Key="IconPlus">M12 5v14M5 12h14</StreamGeometry>
  <StreamGeometry x:Key="IconRefresh">M19 12a7 7 0 11-2.2-5.1 M19.5 4v4.5H15</StreamGeometry>
  <StreamGeometry x:Key="IconSearch">M5.0,10.5 a5.5,5.5 0 1 0 11.0,0 a5.5,5.5 0 1 0 -11.0,0 z M15 15l5 5</StreamGeometry>
  <StreamGeometry x:Key="IconServers">M3.5,4.0 h17.0 v6.0 h-17.0 z M3.5,14.0 h17.0 v6.0 h-17.0 z M7 7h2M7 17h2</StreamGeometry>
  <StreamGeometry x:Key="IconUndo">M9 7L4.5 11.5 9 16 M5 11.5h9a5 5 0 010 10h-3</StreamGeometry>
  <StreamGeometry x:Key="IconWarning">M12 3.5L22 20.5H2z M12 10v5M12 17.2v1.6</StreamGeometry>
  <!-- Check mark for checkboxes (the circled "ok" icon is too busy at 12 px). Hand-written, not generated. -->
  <StreamGeometry x:Key="IconCheckMark">M5,12.5 L10,17.5 L19,7</StreamGeometry>
  <!-- Back chevron for the Settings header. Hand-written, not generated. -->
  <StreamGeometry x:Key="IconChevronLeft">M15 6l-6 6 6 6</StreamGeometry>
</ResourceDictionary>

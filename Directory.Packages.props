<Project>
  <!-- Central package management: every NuGet version is pinned here (no floating versions). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="11.3.22" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageVersion Include="Avalonia.Themes.Simple" Version="11.3.22" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageVersion Include="PeNet" Version="5.1.0" />
    <PackageVersion Include="Avalonia.Headless" Version="11.3.22" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="11.3.22" />
    <PackageVersion Include="Avalonia.Skia" Version="11.3.22" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="FsCheck.Xunit" Version="3.4.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>

<Project>
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <Authors>Realm Portal contributors</Authors>
    <!-- Single source of the product version: AppInfo.Version (status bar, CLI version output) and the release
         packages (packaging/resolve-version.sh) all read it from here. Bump it before tagging a release. -->
    <Version>1.0.1</Version>
  </PropertyGroup>
  <!-- Trimmed publish disables JSON reflection by default; the app uses JsonSerializer for config and loc tables. -->
  <PropertyGroup Condition="'$(PublishTrimmed)' == 'true'">
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
</Project>

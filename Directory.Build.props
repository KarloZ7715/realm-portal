<Project>
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <Authors>Realm Portal contributors</Authors>
    <!-- Single source of the product version: AppInfo.Version (status bar, CLI version output) and the release
         packages (packaging/resolve-version.sh) all read it from here. Bump it before tagging a release. -->
    <Version>1.0.1</Version>
  </PropertyGroup>
  <!-- Trimmed publish disables JSON reflection by default; the app uses JsonSerializer for config and loc tables. -->
  <PropertyGroup Condition="'$(PublishTrimmed)' == 'true'">
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <!-- Packaging sets InstallKind and AppImageSelfReplace at publish time (docs/updates-and-status.md). -->
  <PropertyGroup>
    <InstallKind Condition="'$(InstallKind)' == ''">Unknown</InstallKind>
    <AppImageSelfReplace Condition="'$(AppImageSelfReplace)' == ''">false</AppImageSelfReplace>
    <DefineConstants Condition="'$(InstallKind)' == 'AppImage'">$(DefineConstants);REALM_PORTAL_INSTALL_APPIMAGE</DefineConstants>
    <DefineConstants Condition="'$(InstallKind)' == 'Deb'">$(DefineConstants);REALM_PORTAL_INSTALL_DEB</DefineConstants>
    <DefineConstants Condition="'$(InstallKind)' == 'WindowsZip'">$(DefineConstants);REALM_PORTAL_INSTALL_WINDOWSZIP</DefineConstants>
    <DefineConstants Condition="'$(AppImageSelfReplace)' == 'true'">$(DefineConstants);REALM_PORTAL_APPIMAGE_SELF_REPLACE</DefineConstants>
  </PropertyGroup>
</Project>

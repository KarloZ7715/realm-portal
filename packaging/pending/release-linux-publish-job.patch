@@ -141,6 +146,8 @@ jobs:
     name: win-x64 self-contained artifact
     runs-on: windows-latest
     timeout-minutes: 30
+    outputs:
+      version: ${{ steps.version.outputs.version }}
     env:
       EVENT_NAME: ${{ github.event_name }}
